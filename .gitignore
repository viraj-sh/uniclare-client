**__pycache__
src/uniclare_client/interfaces/desktop/static
flatpak-pip-generator.py
flatpak-builder-tools-master
.flatpak-builder
Makefile
repo
*.flatpak
# Ignore contents by default (using /* leaves the door open for whitelists)
packaging/flatpak/*
packaging/deb/*

# Whitelist ONLY your specific file extensions

# Flatpak
!packaging/flatpak/*.json
!packaging/flatpak/*.desktop
!packaging/flatpak/*.xml
!packaging/flatpak/*.svg
!packaging/flatpak/*.yml

# Deb (This will now work at any nested depth)
!packaging/deb/**/
!packaging/deb/**/*.json
!packaging/deb/**/*.desktop
!packaging/deb/**/*.xml
!packaging/deb/**/*.svg
!packaging/deb/**/*.yml